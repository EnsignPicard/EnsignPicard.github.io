    <div class="skill-group"><h3>Languages</h3><div class="skill-tags"><span class="skill-tag">Java</span><span class="skill-tag">Kotlin</span><span class="skill-tag">Python</span><span class="skill-tag">C/C++</span><span class="skill-tag">TypeScript</span><span class="skill-tag">Bash</span><span class="skill-tag">SQL</span></div></div>
    <div class="skill-group"><h3>Mobile &amp; Android</h3><div class="skill-tags"><span class="skill-tag">Android Development</span><span class="skill-tag">Jetpack Compose</span><span class="skill-tag">Gradle</span><span class="skill-tag">Maven</span></div></div>
    <div class="skill-group"><h3>Web &amp; Backend</h3><div class="skill-tags"><span class="skill-tag">Astro</span><span class="skill-tag">React.js</span><span class="skill-tag">Next.js</span><span class="skill-tag">Spring Boot</span><span class="skill-tag">FastAPI</span><span class="skill-tag">REST APIs</span></div></div>
    <div class="skill-group"><h3>Cloud &amp; DevOps</h3><div class="skill-tags"><span class="skill-tag">AWS</span><span class="skill-tag">Docker</span><span class="skill-tag">Git</span><span class="skill-tag">CI/CD</span><span class="skill-tag">JUnit</span><span class="skill-tag">Mockito</span></div></div>
    <div class="skill-group"><h3>Data &amp; Databases</h3><div class="skill-tags"><span class="skill-tag">PostgreSQL</span><span class="skill-tag">MongoDB</span><span class="skill-tag">Data Analysis</span><span class="skill-tag">Data Structures</span></div></div>
    <div class="skill-group"><h3>AI &amp; ML</h3><div class="skill-tags"><span class="skill-tag">RAG</span><span class="skill-tag">PyTorch</span><span class="skill-tag">Fuzzy Logic</span><span class="skill-tag">A* Search</span><span class="skill-tag">NLP</span><span class="skill-tag">Deep Learning</span><span class="skill-tag">Transfer Learning</span></div></div>
  </div>
</section>

